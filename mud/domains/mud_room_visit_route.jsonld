{
  "@context": {
    "vsekai": "https://v-sekai.org/",
    "domain": "vsekai:planning/domain/"
  },
  "@type": "domain:Definition",
  "name": "mud_room_visit_route",
  "variables": [
    { "name": "at", "init": { "player_1": "gate" } },
    { "name": "visited", "init": { "captain": false, "merchant": false } }
  ],
  "actions": {
    "move": {
      "params": ["player", "from", "to"],
      "body": [
        { "pointer/set": "/at/{player}", "value": "{to}" }
      ]
    },
    "talk_captain": {
      "params": ["player"],
      "body": [
        { "eval": { "type": "math/eq",
                    "a": { "type": "pointer/get", "pointer": "/at/{player}" },
                    "b": "docks" } },
        { "pointer/set": "/visited/captain", "value": true }
      ]
    },
    "talk_merchant": {
      "params": ["player"],
      "body": [
        { "eval": { "type": "math/eq",
                    "a": { "type": "pointer/get", "pointer": "/at/{player}" },
                    "b": "market" } },
        { "pointer/set": "/visited/merchant", "value": true }
      ]
    }
  },
  "methods": {
    "go_docks": {
      "params": ["player"],
      "alternatives": [
        { "name": "already_docks",
          "check": [{ "eval": { "type": "math/eq",
                                 "a": { "type": "pointer/get", "pointer": "/at/{player}" },
                                 "b": "docks" } }],
          "subtasks": [] },
        { "name": "gate_to_docks",
          "check": [{ "eval": { "type": "math/eq",
                                 "a": { "type": "pointer/get", "pointer": "/at/{player}" },
                                 "b": "gate" } }],
          "subtasks": [["move", "{player}", "gate", "docks"]] },
        { "name": "market_to_docks",
          "subtasks": [["move", "{player}", "market", "docks"]] }
      ]
    },
    "go_market": {
      "params": ["player"],
      "alternatives": [
        { "name": "already_market",
          "check": [{ "eval": { "type": "math/eq",
                                 "a": { "type": "pointer/get", "pointer": "/at/{player}" },
                                 "b": "market" } }],
          "subtasks": [] },
        { "name": "gate_to_market",
          "check": [{ "eval": { "type": "math/eq",
                                 "a": { "type": "pointer/get", "pointer": "/at/{player}" },
                                 "b": "gate" } }],
          "subtasks": [["move", "{player}", "gate", "market"]] },
        { "name": "docks_to_market",
          "subtasks": [["move", "{player}", "docks", "market"]] }
      ]
    },
    "visit_captain": {
      "params": ["player"],
      "alternatives": [
        { "name": "route", "subtasks": [["go_docks", "{player}"], ["talk_captain", "{player}"]] }
      ]
    },
    "visit_merchant": {
      "params": ["player"],
      "alternatives": [
        { "name": "route", "subtasks": [["go_market", "{player}"], ["talk_merchant", "{player}"]] }
      ]
    }
  },
  "todo_list": [
    ["visit_captain", "player_1"],
    ["visit_merchant", "player_1"]
  ]
}
